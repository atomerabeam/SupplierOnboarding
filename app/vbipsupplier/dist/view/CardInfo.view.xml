<mvc:View controllerName="vbipsupplier.controller.CardInfo"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core" displayBlock="true"
    xmlns="sap.m">
    <Page id="id.Page" class="sapUiContentPadding">
        <VBox id="vboxBI" alignItems="Center" justifyContent="Center" height="100%" width="100%">
            <BusyIndicator id="BI" text="It might take up to a minute, please don't refresh" visible="false"/>
        </VBox>
        <customHeader>
            <core:Fragment fragmentName="vbipsupplier.view.fragment.HeaderContent" type="XML"/>
        </customHeader>
        <content>
            <core:Fragment fragmentName="vbipsupplier.view.fragment.CardInfo" type="XML"/>
        </content>
        <footer>
            <core:Fragment fragmentName="vbipsupplier.view.fragment.FooterContent" type="XML"/>
        </footer>
    </Page>
</mvc:View>